{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChunkPatch",
  "version": "0.1.5",
  "identifier": "com.makrofaj.chunkpatch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ChunkPatch",
        "width": 1200,
        "height": 850,
        "minWidth": 1080,
        "minHeight": 820,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https://steamcdn-a.akamaihd.net https://raw.githubusercontent.com data:; connect-src 'self' https://raw.githubusercontent.com https://api.github.com ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/rokmakrofaj/chunkpatch/main/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5OUZCRTIwOUFBREQwQjYKUldTMjBLMmFJTDZmV1J2Wm5KL2dxeEhKNjMveHozcnBkcEpJTXdzUEF1OStpcDY4NFl6RU5RWW8K"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "ChunkPatch Team",
    "shortDescription": "Modern Türkçe Yama Yöneticisi",
    "longDescription": "Oyunlarınız için Türkçe yamaları otomatik indiren ve kuran, tamamen güvenli, açık kaynaklı bir yama yöneticisi.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "license.txt",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": true
      },
      "wix": {
        "language": "tr-TR"
      }
    }
  }
}
